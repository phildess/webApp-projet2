# Configuration Docker pour Centre de Formation
# Ce fichier contient les variables d'environnement pour Docker Compose

# PostgreSQL
POSTGRES_USER=centre_admin
POSTGRES_PASSWORD=centre_password_2025
POSTGRES_DB=centre_formation

# Backend
DATABASE_URL=postgresql://centre_admin:centre_password_2025@postgres:5432/centre_formation?schema=public
JWT_SECRET=centre-formation-super-secret-key-docker-2025
JWT_EXPIRES_IN=7d
PORT=3000
NODE_ENV=production
FRONTEND_URL=http://localhost

# Frontend
VITE_API_URL=http://localhost:3000/api
