# Variables d'environnement pour Docker Compose
# Copiez ce fichier en .env pour personnaliser les valeurs

# PostgreSQL
POSTGRES_USER=centre_admin
POSTGRES_PASSWORD=centre_password_2025
POSTGRES_DB=centre_formation
POSTGRES_PORT=5432

# Backend
BACKEND_PORT=3000
JWT_SECRET=centre-formation-super-secret-key-docker-2025-change-in-production
JWT_EXPIRES_IN=7d
FRONTEND_URL=http://localhost

# Frontend
FRONTEND_PORT=80
VITE_API_URL=http://localhost:3000/api

# Node Environment
NODE_ENV=production
